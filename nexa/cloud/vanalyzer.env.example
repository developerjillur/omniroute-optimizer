# Merge these settings into protected Vanalyzer configuration; preserve existing secrets.
ENABLE_NEXAOMNI_PLAN_B=true
NEXAOMNI_BASE_URL=https://nexaomni.nexaconnect.cloud/v1
NEXAOMNI_API_KEY=replace_with_private_cloud_key
NEXAOMNI_MODEL=agy/gemini-3.8-flash-low
PLAN_B_CHUNK_SECONDS=300
PLAN_B_MAX_DURATION_SECONDS=1800
PLAN_B_REQUEST_TIMEOUT_SECONDS=90
PLAN_B_BUDGET_SECONDS=600
# Per client instance. Context also has its own single-job worker limit.
PLAN_B_CONCURRENCY=2
