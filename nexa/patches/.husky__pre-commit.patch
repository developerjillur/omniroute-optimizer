diff --git a/.husky/pre-commit b/.husky/pre-commit
index f56d9044b5b660566e3bca72986afde5301e6727..d822798731235ecb5ddfb7808a15bf8a13591388 100755
--- a/.husky/pre-commit
+++ b/.husky/pre-commit
@@ -18,3 +18,11 @@
 node scripts/check/check-tracked-artifacts.mjs
 # vendored kit must stay byte-identical to the pinned upstream commit; skips with a warning where the private clone is absent
 npm run --silent check:ui-kit-snapshot
+
+# OVERLAY GUARD (nexa child-theme): fail the commit if ANY file outside nexa/
+# drifts from pristine upstream. Golden rule #1 is 'never edit an upstream file
+# on nexalance' — before this hook that rule was documented but not enforced, so
+# a direct edit to Dockerfile/.npmrc/src/** could be committed and would then
+# collide with the overlay at build time (and be silently dropped by a plain
+# `docker build`, which skips patch application entirely).
+node nexa/check/pristine-base.mjs
