+/** Native message IDs support exact session/usage correlation without storing content. */
+export function extractNativeMessageId(
+  sourceFormat: unknown,
+  clientResponse: unknown,
+): string | null {
+  if (
+    sourceFormat !== FORMATS.CLAUDE ||
+    !clientResponse ||
+    typeof clientResponse !== "object"
+  )
+    return null;
+  const envelope = clientResponse as Record<string, unknown>;
+  const body =
+    envelope.summary && typeof envelope.summary === "object"
+      ? (envelope.summary as Record<string, unknown>)
+      : envelope;
+  return body.type === "message" &&
+    typeof body.id === "string" &&
+    /^msg_[A-Za-z0-9_-]{1,192}$/.test(body.id)
+    ? body.id
+    : null;
