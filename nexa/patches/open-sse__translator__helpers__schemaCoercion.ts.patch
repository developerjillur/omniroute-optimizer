+function hasUnsupportedResponsesRegex(pattern: unknown): boolean {
+  if (typeof pattern !== "string") return false;
+  if (hasUnsupportedRegexLookaround(pattern)) return true;
+  // Responses validates Unicode scalar regexes. Native MCP schemas can contain
+  // lone-surrogate escapes (including a range excluding them), which are valid
+  // ECMAScript syntax but rejected by the upstream regex validator. Preserve
+  // the tool and its other constraints; its native runtime still validates input.
+  // An escaped literal backslash is not a Unicode escape.
+  if (/(^|[^\\])(?:\\\\)*\\u[dD][89a-fA-F][0-9a-fA-F]{2}/.test(pattern)) return true;
+  return Array.from(pattern).some((character) => {
+    const point = character.codePointAt(0)!;
+    return point >= 0xd800 && point <= 0xdfff;
+  });
+}
