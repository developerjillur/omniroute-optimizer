+  const schema = record.input_schema;
+  if (!schema || typeof schema !== "object" || Array.isArray(schema)) return false;
+  const inputSchema = schema as JsonRecord;
+  const properties = inputSchema.properties;
+  if (!properties || typeof properties !== "object" || Array.isArray(properties)) return false;
+  return (
+    record.name === "DeferredToolPlaceholder" &&
+    record.defer_loading === true &&
+    record.description ===
+      "Reserved placeholder that keeps deferred tool loading active; never call this tool." &&
+    inputSchema.type === "object" &&
+    Object.keys(properties).length === 0 &&
+    (inputSchema.required === undefined ||
+      (Array.isArray(inputSchema.required) && inputSchema.required.length === 0))
+  );
+}
