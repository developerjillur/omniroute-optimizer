 import { getDbInstance } from "./core";
+import { cacheTtlTokenSql, withCacheTtlColumns } from "./usageAnalytics/cacheTtl";
+import { GPT_6_1_SOL_LONG_CONTEXT_THRESHOLD } from "@/shared/constants/pricing/shared-tiers";
+
+// Partition this model by each request, never by a summed day/model token total.
+function pricingContextBucket(prefix = "", aggregated = true): string {
+  return `CASE WHEN ${prefix}tokens_input > ${GPT_6_1_SOL_LONG_CONTEXT_THRESHOLD}
+    AND LOWER(${prefix}model) LIKE '%gpt-6.1-sol%'
+    ${aggregated ? `AND ${prefix}is_aggregated = 0` : ""}
+    THEN 1 ELSE 0 END`;
+}
+
