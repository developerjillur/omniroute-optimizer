+
+function hasLoopbackHostEntry(hostsContent: string, hostname: string): boolean {
+  return hostsContent.split(/\r?\n/).some((line) => {
+    const parts = line.split("#", 1)[0].trim().split(/\s+/);
+    return (parts[0] === "127.0.0.1" || parts[0] === "::1") && parts.slice(1).includes(hostname);
+  });
+}
+
+/** Stop must detect partial IPv4/IPv6 entries and fail if the hosts file cannot be read. */
+export function hasAnyDNSEntries(hosts: string[]): boolean {
+  if (hosts.length === 0) return false;
+  const content = fs.readFileSync(hostsFilePath(), "utf8");
+  return hosts.some((host) => hasLoopbackHostEntry(content, host));
 }
 
