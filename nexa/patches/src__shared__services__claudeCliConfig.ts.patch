+import { normalizeClaudeModelId } from "../../mitm/_internal/claudeModels.cjs";
+export { normalizeClaudeModelId };
+
+/** Merge only requested fields; Fable remains an independently managed owner choice. */
+export function planClaudeSettings(
+  currentSettings: Record<string, any>,
+  requestedEnv: Record<string, string>
+) {
+  const env = { ...(currentSettings.env || {}) };
+  for (const [key, value] of Object.entries(requestedEnv)) {
+    if (key === "ANTHROPIC_DEFAULT_FABLE_MODEL") continue;
+    env[key] =
+      key === "ANTHROPIC_MODEL" || /^ANTHROPIC_DEFAULT_[A-Z0-9_]+_MODEL$/.test(key)
+        ? normalizeClaudeModelId(value)
+        : value;
+  }
+  if (env.ANTHROPIC_BASE_URL) {
+    env.ANTHROPIC_BASE_URL = normalizeClaudeBaseUrl(env.ANTHROPIC_BASE_URL);
+  }
+  const previous = currentSettings.env || {};
+  const changes = Object.keys(requestedEnv)
+    .filter((key) => key !== "ANTHROPIC_DEFAULT_FABLE_MODEL" && previous[key] !== env[key])
+    .sort()
+    .map((key) => ({
+      key,
+      before: /TOKEN|SECRET|PASSWORD|API_KEY/i.test(key)
+        ? previous[key] === undefined
+          ? null
+          : "[redacted]"
+        : (previous[key] ?? null),
+      after: /TOKEN|SECRET|PASSWORD|API_KEY/i.test(key) ? "[redacted]" : env[key],
+    }));
+  return { settings: { ...currentSettings, env }, changes };
+}
+
 export function normalizeClaudeBaseUrl(value: string): string {
   return String(value || "")
     .trim()
