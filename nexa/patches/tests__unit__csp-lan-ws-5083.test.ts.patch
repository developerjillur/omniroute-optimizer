+// Inspect effective configuration so computed production policy is covered too.
+async function connectSrcDirective(): Promise<string> {
+  const mod = await import(
+    `${pathToFileURL(resolve(here, "../../next.config.mjs")).href}?csp=${Date.now()}-${Math.random()}`
+  );
+  const rules = (await mod.default.headers()) as {
+    headers: { key: string; value: string }[];
+  }[];
+  const csp = rules
+    .flatMap((rule) => rule.headers)
+    .find((header) => header.key.toLowerCase() === "content-security-policy")?.value;
+  const directive = csp
+    ?.split(";")
+    .map((part) => part.trim())
+    .find((part) => part.startsWith("connect-src "));
+  assert.ok(directive, "effective security headers must define connect-src");
+  return directive;
 }
 
